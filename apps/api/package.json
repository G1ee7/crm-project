{
  "name": "@warehouse/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc -p tsconfig.json",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply warehouse-demo --local && wrangler d1 execute warehouse-demo --local --file=seed.sql"
  },
  "dependencies": {
    "@warehouse/db": "*",
    "@warehouse/shared": "*",
    "@warehouse/types": "*",
    "drizzle-orm": "^0.44.7",
    "hono": "^4.10.3",
    "zod": "^4.1.0"
  },
  "devDependencies": { "@cloudflare/workers-types": "^4.20251014.0", "typescript": "^5.9.3", "wrangler": "^4.45.0" }
}
