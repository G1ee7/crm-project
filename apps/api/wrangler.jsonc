{
  "name": "warehouse-demo-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "warehouse-demo",
    "database_id": "a181bc83-e2b3-4eaa-8f1b-6bf5ac73d796",
    "migrations_dir": "migrations"
  }]
}
