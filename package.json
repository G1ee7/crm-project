{
  "name": "warehouse",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "npm run dev -w @warehouse/web",
    "dev:api": "npm run dev -w @warehouse/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "build": "npm run build -w @warehouse/web && npm run build -w @warehouse/api",
    "deploy": "npm run build -w @warehouse/web && npm run deploy -w @warehouse/api",
    "db:generate": "npm run db:generate -w @warehouse/db",
    "db:migrate:local": "npm run db:migrate:local -w @warehouse/api"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
